{
  "name": "forumaker/yandex-smartcaptcha",
  "description": "Adds Yandex SmartCaptcha to the login and registration modals",
  "type": "flarum-extension",
  "keywords": ["flarum", "flarum-extension", "yandex", "smartcaptcha", "captcha"],
  "license": "MIT",
  "homepage": "https://github.com/forumaker/yandex-smartcaptcha",
  "support": {
    "issues": "https://github.com/forumaker/yandex-smartcaptcha/issues",
    "source": "https://github.com/forumaker/yandex-smartcaptcha",
    "forum": "https://discuss.flarum.org/"
  },
  "authors": [
    {
      "name": "forumaker",
      "role": "Developer",
      "homepage": "https://github.com/forumaker"
    }
  ],
  "require": {
    "php": "^8.2",
    "flarum/core": "^2.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "forumaker\\YandexSmartCaptcha\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-2.x": "2.x-dev"
    },
    "flarum-extension": {
      "title": "Yandex SmartCaptcha",
      "category": "feature",
      "icon": {
        "name": "fa-solid fa-shield-halved",
        "backgroundColor": "#FC3F1D",
        "color": "#ffffff"
      }
    }
  },
  "config": {
    "sort-packages": true
  }
}
